# Copy thành .env (dev local)
# Vite chỉ nhúng biến VITE_* lúc npm run build — sửa trên Vercel phải Redeploy

# --- Dev: backend local ---
# VITE_API_BASE_URL=http://localhost:8080

# --- Dev: gọi BE trên Render ---
VITE_API_BASE_URL=https://be-vietlocal.onrender.com

# Khớp PAYMENT_WEBHOOK_SECRET trên Render (BE)
VITE_PAYMENT_WEBHOOK_SECRET=vietlocal-dev-secret
